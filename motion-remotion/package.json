{
  "name": "arquivo-otaku-motion-remotion",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts ArquivoOtaku",
    "compositions": "remotion compositions src/index.ts",
    "render:master": "remotion render src/index.ts ArquivoOtakuMaster",
    "test:character": "node --test tests/character-idle.test.cjs",
    "test:shorts": "node --test tests/shorts-pacing.test.cjs",
    "test:qa": "node --test tests/character-idle.test.cjs tests/shorts-pacing.test.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "remotion": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
